# Copiar fuera del control de versiones y configurar en el VPS; nunca rellenar aquí.
NUXT_DIRECTUS_URL=https://admin.captotal.com
NUXT_DIRECTUS_TOKEN=
NUXT_PUBLIC_SITE_URL=https://captotal.com
NUXT_REDSYS_SECRETO=
NUXT_REDSYS_COMERCIO=
NUXT_REDSYS_TERMINAL=1
NUXT_PAGOS_DIR=.data/pagos
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_RECAPTCHA_SECRET=
NUXT_RECAPTCHA_HOSTNAMES=captotal.com,www.captotal.com
# Solo después de configurar proxy_set_header X-Real-IP $remote_addr en nginx:
NUXT_TRUSTED_PROXY_IPS=
